{
    "name": "phonebook-backend",
    "version": "1.0.0",
    "description": "Full Stack Open Part 3 - Phonebook Backend",
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
