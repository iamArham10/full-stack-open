        "dotenv": "^18.0.5",
        "express": "^5.2.1",
        "mongoose": "^9.10.3",
        "morgan": "^1.12.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.12.0",
        "globals": "^17.13.0"
    }
}
